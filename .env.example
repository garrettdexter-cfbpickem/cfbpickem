# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CollegeFootballData.com API key (https://collegefootballdata.com/key)
CFBD_API_KEY=your-cfbd-api-key

# Season year, e.g. 2026
SEASON_YEAR=2026

# Shared secret you make up. Used to protect the admin sync/score API
# endpoints AND as the password for the /admin login page (its value is
# also what gets stored in the admin_session cookie after a successful
# login).
ADMIN_SECRET=change-me-to-something-random

# Shared secret Vercel Cron will send; can be the same as ADMIN_SECRET.
# Used by /api/cron/lock-lines (Thursdays noon) and /api/cron/score
# (Sundays 4am).
CRON_SECRET=change-me-to-something-random-too
